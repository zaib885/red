# =====================================================================
# RoutVia - Environment configuration  (LOCAL FILE - never commit/share)
# Replace every YOUR_... value with your own. Restart `npm run dev`
# after any change to this file.
# While values still start with "YOUR_", the app runs in Demo Mode.
# =====================================================================

# ---------- Firebase (Console > Project settings > Your apps > Web app) ----------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
# Realtime Database URL (Console > Realtime Database > Data tab, top of the page).
# US region : https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
# Other region: https://YOUR_PROJECT_ID-default-rtdb.REGION.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# ---------- Dev server / Ngrok ----------
# Port of the Vite dev server (must match `ngrok http <port>`)
VITE_DEV_PORT=5173
# Optional: extra allowed hosts, comma separated. Normally NOT needed because
# *.ngrok-free.app / *.ngrok-free.dev / *.ngrok.io / *.ngrok.app are already allowed.
# Example: VITE_ALLOWED_HOST=my-custom-domain.ngrok.dev
VITE_ALLOWED_HOST=

# ---------- App behaviour ----------
# Demo Mode: auto = on only when Firebase is not configured | on = always | off = never
VITE_DEMO_MODE=auto
# ETA settings (approximate, straight-line based - no paid routing API)
VITE_AVERAGE_BUS_SPEED_KMH=20
VITE_MIN_USABLE_GPS_SPEED_KMH=5
VITE_ROAD_DISTANCE_MULTIPLIER=1.35
# Bus data older than this many seconds is treated as "Waiting for Driver Location"
VITE_STALE_AFTER_SECONDS=60
# Minimum seconds between GPS writes from the driver phone (protects Firebase Spark quota)
VITE_GPS_WRITE_INTERVAL_SECONDS=3
